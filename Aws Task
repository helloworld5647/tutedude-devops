TASK 3 — Deploy Using Docker + ECR + ECS + VPC
STEP 1 — Install Docker
sudo apt update
sudo apt install docker.io -y
sudo systemctl start docker
sudo systemctl enable docker
sudo usermod -aG docker ubuntu
newgrp docker
STEP 2 — Create ECR Repositories

Go to:

ECR → Private repositories

Create:

flask-backend
express-frontend
STEP 3 — Install AWS CLI
curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip"


sudo apt install unzip -y


unzip awscliv2.zip


sudo ./aws/install

Verify:

aws --version
STEP 4 — Configure AWS CLI
aws configure

Enter:

AWS Access Key
AWS Secret Key
Region: us-east-1
Output: json
STEP 5 — Login to ECR
aws ecr get-login-password --region us-east-1 | docker login --username AWS --password-stdin 426449772516.dkr.ecr.us-east-1.amazonaws.com

Expected:

Login Succeeded
STEP 6 — Build Backend Docker Image
cd ~/tutedude-devops/backend


docker build -t flask-backend .
STEP 7 — Tag Backend Image
docker tag flask-backend:latest 426449772516.dkr.ecr.us-east-1.amazonaws.com/flask-backend:latest
STEP 8 — Push Backend Image
docker push 426449772516.dkr.ecr.us-east-1.amazonaws.com/flask-backend:latest
STEP 9 — Build Frontend Docker Image
cd ~/tutedude-devops/frontend


docker build -t express-frontend .
STEP 10 — Tag Frontend Image
docker tag express-frontend:latest 426449772516.dkr.ecr.us-east-1.amazonaws.com/express-frontend:latest
STEP 11 — Push Frontend Image
docker push 426449772516.dkr.ecr.us-east-1.amazonaws.com/express-frontend:latest
